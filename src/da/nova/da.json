        "onAccent": "#ffffff",
        "accentSoft": "#3b3a7a",
        "danger": "#ff7a9c",
        "titleBg": "#253165",
        "titleFg": "#ffffff",
        "titleLine": "#6f5ca4"
      },
      "titleImage": "assets/titre-jour.png",
      "backgroundImage": "assets/fond.png"
    }
  }
}
