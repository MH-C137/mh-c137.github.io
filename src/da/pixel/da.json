{
  "name": "Arcade pixel",
  "description": "La DA d'origine : style console d'arcade, cyan et violet sur fond noir, coins carrés, police pixel.",
  "defaultTheme": "night",
  "fonts": [
    {
      "family": "Jersey 10",
      "file": "assets/fonts/jersey-10-latin-400-normal.woff2",
      "weight": "400"
    }
  ],
  "ui": {
    "fontFamily": "'Jersey 10', ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace",
    "textScale": 1,
