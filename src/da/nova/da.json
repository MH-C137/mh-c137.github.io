        "outline": "#253165",
        "glass": "rgba(37, 49, 101, 0.62)",
        "stars": "#dfe8ff"
      },
      "interface": {
        "bg": "#253165",
        "fg": "#253165",
        "muted": "#5d6690",
        "surface": "#ffffff",
        "surface2": "#eef1f8",
        "hover": "#e2e6f3",
        "line": "#6f5ca4",
