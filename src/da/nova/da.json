{
  "name": "Nova",
  "description": "La DA de l'équipe artistique : cellules en étoiles (jaune = naît, blanc = vit, violet = meurt), quadrillage à croix posé comme une vitre devant une constellation quasi infinie, interface blanche à détails violets, titre jaune.",
  "defaultTheme": "night",
  "fonts": [
    {
      "family": "Space Grotesk",
      "file": "assets/fonts/space-grotesk-latin-400-normal.woff2",
      "weight": "400"
    },
    {
      "family": "Space Grotesk",
      "file": "assets/fonts/space-grotesk-latin-700-normal.woff2",
      "weight": "700"
    }
  ],
  "ui": {
    "fontFamily": "'Space Grotesk', system-ui, 'Segoe UI', Helvetica, Arial, sans-serif",
    "textScale": 0.68,
    "frame": "flat",
    "borderWidth": 2
  },
  "title": {
    "text": "Nova : comprendre le « Jeu de la vie »",
    "imageHeight": 72
  },
  "cells": {
    "icon": "assets/etoile.png",
    "scale": 1,
    "iconMinZoom": 6,
    "outlineWidth": 0.05,
    "fadeTrail": true,
    "pulseHalo": true
  },
  "grid": {
    "style": "crosses"
  },
  "background": {
    "style": "constellation",
    "opacity": 1,
    "density": 1,
    "parallax": 0.3
  },
  "themes": {
    "night": {
      "colors": {
        "background": "#253165",
        "grid": "rgba(255, 255, 255, 0.2)",
