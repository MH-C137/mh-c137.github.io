{
  "name": "Nova",
  "description": "La DA de l'équipe artistique : cellules en étoiles (jaune = naît, blanc = vit, contour blanc = vient de mourir ; en jour : violet / bleu nuit), quadrillage à croix devant une constellation fixe sans fin, interface bleu nuit à texte blanc et détails violets, titre jaune (nuit) ou bleu clair (jour).",
  "defaultTheme": "night",
  "fonts": [
    {
      "family": "Space Grotesk",
      "file": "assets/fonts/space-grotesk-latin-400-normal.woff2",
      "weight": "400"
    },
    {
      "family": "Space Grotesk",
      "file": "assets/fonts/space-grotesk-latin-700-normal.woff2",
      "weight": "700"
    }
  ],
  "palette": [
    "#548ebc",
    "#cbc737",
    "#253165",
    "#6f5ca4",
    "#ffffff"
  ],
  "ui": {
    "fontFamily": "'Space Grotesk', system-ui, 'Segoe UI', Helvetica, Arial, sans-serif",
    "textScale": 0.68,
    "frame": "flat",
    "borderWidth": 2
  },
  "title": {
    "text": "Nova : comprendre le « Jeu de la vie »",
    "imageHeight": 72
  },
  "cells": {
    "icon": "assets/etoile.png",
    "scale": 1,
    "iconMinZoom": 6,
    "traceStyle": "outline",
    "outlineWidth": 0.08,
    "pulseHalo": true
  },
  "grid": {
    "style": "crosses"
  },
  "background": {
    "style": "constellation",
    "opacity": 1,
    "density": 1
  },
  "themes": {
    "night": {
      "colors": {
        "background": "#253165",
        "grid": "rgba(255, 255, 255, 0.2)",
        "gridMajor": "rgba(255, 255, 255, 0.46)",
        "newborn": "#cbc737",
        "alive": "#ffffff",
        "pulse": "#ffffff",
        "trace": "#ffffff",
        "selection": "#cbc737",
        "erase": "#ff7a9c",
        "glass": "rgba(37, 49, 101, 0.62)",
        "stars": "#dfe8ff"
      },
      "interface": {
        "bg": "#253165",
        "fg": "#ffffff",
        "muted": "#c3cbe8",
        "surface": "#1a2350",
        "surface2": "#2b3a78",
        "hover": "#364891",
        "line": "#6f5ca4",
        "lineSoft": "#4d4a8c",
        "drop": "#00000000",
        "accent": "#b3a6e8",
        "accentFill": "#6f5ca4",
        "onAccent": "#ffffff",
        "accentSoft": "#3b3a7a",
        "danger": "#ff7a9c",
        "titleBg": "#1a2350",
        "titleFg": "#ffffff",
        "titleLine": "#6f5ca4"
      },
      "titleImage": "assets/titre-nuit.png",
      "backgroundImage": "assets/fond.png"
    },
    "day": {
      "colors": {
        "background": "#ffffff",
        "grid": "rgba(37, 49, 101, 0.2)",
        "gridMajor": "rgba(37, 49, 101, 0.44)",
        "newborn": "#6f5ca4",
        "alive": "#253165",
        "pulse": "#253165",
        "trace": "#253165",
        "selection": "#6f5ca4",
        "erase": "#d6336c",
        "glass": "rgba(255, 255, 255, 0.64)",
        "stars": "#548ebc"
      },
      "interface": {
        "bg": "#ffffff",
        "fg": "#ffffff",
